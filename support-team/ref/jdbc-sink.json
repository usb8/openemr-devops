{
    "name": "mariadb-sink",
    "config": {
        "connection.driver": "org.mariadb.jdbc.Driver",
        "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
        "tasks.max": "1",
        "connection.url": "jdbc:mysql://mysql-replica:3306/openemr",
        "connection.username": "root",
        "connection.password": "root",
        "topics.regex": "openemr-changes\\..*",
        "table.name.format": "${topic}",
        "auto.create": "true",
        "auto.evolve": "true",
        "database.schema.evolution": "true",
        "schema.evolution": "basic",
        "insert.mode": "upsert",
        "primary.key.mode": "record_value",
        "primary.key.fields": "",
        "key.converter": "org.apache.kafka.connect.json.JsonConverter",
        "value.converter": "org.apache.kafka.connect.json.JsonConverter",
        "key.converter.schemas.enable": "false",
        "value.converter.schemas.enable": "true",
        "transforms": "unwrap, regexrouter",
        "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
        "transforms.regexrouter.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.key.type": "org.apache.kafka.connect.transforms.ExtractKeyFromStruct",
        "transforms.key.fields": "",
        "transforms.key.fallback.strategy": "hash",
        "transforms.regexrouter.regex": "openemr-changes\\.(.)\\.(.)",
        "transforms.regexrouter.replacement": "$2",
        "errors.log.enable": "true",
        "errors.log.include.messages": "true"
    }
}